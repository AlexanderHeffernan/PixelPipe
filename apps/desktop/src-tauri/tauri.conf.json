{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pixelate",
  "version": "0.1.0",
  "identifier": "dev.pixelate.workstation",
  "build": {
    "beforeDevCommand": "npm run prepare:cli && npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Pixelate",
        "width": 1440,
        "height": 900,
        "minWidth": 1040,
        "minHeight": 680,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": true,
        "windowEffects": {
          "effects": ["sidebar"],
          "state": "active"
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "externalBin": ["binaries/pixelate"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/Pixelate.icon"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEExNUJEQUY5QTQ3OEVBQkQKUldTOTZuaWsrZHBib2FINlVyN2EwbXdUVmowcFAvRXNPNmpkRURSTkt6NnRuOG5UNlFZUHFGdlUK",
      "endpoints": [
        "https://github.com/AlexanderHeffernan/Pixelate/releases/latest/download/latest.json"
      ]
    }
  }
}
