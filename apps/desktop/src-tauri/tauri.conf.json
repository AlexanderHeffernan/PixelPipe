{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PixelPipe",
  "version": "0.1.0",
  "identifier": "dev.pixelpipe.workstation",
  "build": {
    "beforeDevCommand": "npm run prepare:cli && npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "PixelPipe",
        "width": 1440,
        "height": 900,
        "minWidth": 1040,
        "minHeight": 680,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": true,
        "windowEffects": {
          "effects": ["sidebar"],
          "state": "active"
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": false,
    "icon": []
  }
}
